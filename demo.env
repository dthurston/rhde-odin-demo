# Shared settings for the RHEL Device Edge / ODIN demo.
# Sourced by build.sh and tablet/setup-tablet.sh. Edit here, nowhere else.

# Isolated demo LAN (wired switch). Tablet is the hub.
TABLET_IP=10.10.10.1
LAN_PREFIX=24
# Tablet NIC on the demo LAN (check with: nmcli device). USB-ethernet dongles look like enp0s20f0u1.
LAN_IFACE=eth0

# Local registry on the tablet
REGISTRY=${TABLET_IP}:5000

# Laptops: name=ip
NODES="edge-a=10.10.10.11 edge-b=10.10.10.12"

# Red Hat base images (needs a subscribed RHEL host + `podman login registry.redhat.io`)
RHEL_BOOTC=registry.redhat.io/rhel10/rhel-bootc:10.0
BIB_IMAGE=registry.redhat.io/rhel10/bootc-image-builder:10.0

# ODIN release used for the C2 role
ODIN_VERSION=3.3.0

# Offline map tileset name (tiles/<name>.mbtiles)
TILESET=ao

# SSH key the tablet uses to drive the laptops (public half is baked into the image)
SSH_KEY=/root/.ssh/edge_demo
