# Offline map tiles for ODIN (TileJSON discovery at http://<tablet>:8000/services)
[Unit]
Description=Edge demo offline map tiles (:8000)

[Container]
Image=ghcr.io/consbio/mbtileserver:latest
ContainerName=edge-tiles
# Host networking: no port forwarding, which libvirt's isolated-network
# firewall rules reject for VMs ("connection refused" from the edge VMs)
Network=host
Volume=/opt/edge-demo/tiles:/tilesets:ro,Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
